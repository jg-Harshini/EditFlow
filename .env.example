# IncuBrix Configuration Environment Template
APP_NAME="IncuBrix Prompt-Based Video Editing Engine"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=false
LOG_LEVEL="INFO"

# Storage Directories (Relative or Absolute)
TEMP_DIR="temp_data"
STORAGE_DIR="storage_data"
OUTPUT_DIR="outputs"

# Security & Idempotency
WEBHOOK_HMAC_SECRET="incubrix-super-secret-hmac-key"
IDEMPOTENCY_TTL_SECONDS=86400
MAX_UPLOAD_SIZE_BYTES=524288000
DOWNLOAD_TIMEOUT_SECONDS=60

# Background Job Worker
ASYNC_THRESHOLD_SECONDS=2.0
MAX_CONCURRENT_JOBS=4

# Editing Policy
DEFAULT_TIME_POLICY="current"
MIN_CAPTION_DURATION_MS=700
DEFAULT_SILENCE_THRESHOLD_DB=-35.0
DEFAULT_MIN_SILENCE_DURATION_MS=500

# STT Provider ("mock" or "whisper")
STT_PROVIDER="mock"
STT_MODEL_SIZE="base"
USE_GPU=false

# S3 / MinIO Settings
S3_ENABLED=false
S3_ENDPOINT="minio:9000"
S3_BUCKET="incubrix-videos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_USE_SSL=false
